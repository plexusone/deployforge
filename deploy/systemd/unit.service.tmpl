# {{.Unit}}: {{.App}}, stack {{.Stack}}. Generated by deployforge from the fleet document; do not edit by hand.
# Runs as the unprivileged {{.User}} user and listens on loopback only, behind Caddy.
# Secrets come from /etc/{{.Unit}}/env, written from the parameter store at deploy time
# (root:{{.User}}, mode 0640).
[Unit]
Description={{.App}} ({{.Stack}})
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User={{.User}}
Group={{.User}}
EnvironmentFile=/etc/{{.Unit}}/env
# Refuse to start on an invalid configuration or environment (no network).
ExecStartPre=/opt/{{.Unit}}/current/{{.App}} validate -c /etc/{{.Unit}}/config.yaml
ExecStart=/opt/{{.Unit}}/current/{{.App}} serve -c /etc/{{.Unit}}/config.yaml
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=40

# Limits from the fleet document, so one app's spike or leak cannot starve the others.
MemoryMax={{.Limits.MemoryMax}}
CPUQuota={{.Limits.CPUQuota}}

# The app's log directory, /var/log/{{.Unit}}: systemd creates it for the
# service user and makes it writable under ProtectSystem=strict.
LogsDirectory={{.Unit}}
LogsDirectoryMode=0700
{{- if .StateDirectory}}

# The app keeps state on local disk. systemd creates the directory for the
# service user, keeps it private and makes it the one writable path under
# ProtectSystem=strict.
StateDirectory={{.Unit}}
StateDirectoryMode=0700
{{- end}}

# Hardening
{{- range .Hardening}}
{{.}}{{end}}
ReadOnlyPaths=/opt/{{.Unit}} /etc/{{.Unit}}

[Install]
WantedBy=multi-user.target
