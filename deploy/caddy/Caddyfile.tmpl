# Generated by `deployforge caddyfile` from the fleet document; do not edit.
# Host {{.Host}}: one block per stack on it, each forwarding its host names to
# its app's loopback port.
{
{{- if .DisableCerts}}
	# Every app on this host is behind Cloudflare, whose firewall rules
	# leave ACME no way in: each block serves its zone's origin
	# certificate, and Caddy gets none itself.
	auto_https disable_certs
{{- end}}
{{- if .Email}}
	email {{.Email}}
{{- end}}
{{- if .Ranges}}
	servers {
		# Cloudflare's proxy ranges. Only a request from one of them may set
		# the client address through these headers; any other request's
		# client address is its peer's.
		trusted_proxies static {{join .Ranges " "}}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
{{- end}}
}

(common) {
	encode zstd gzip
	# Defaults only ("?"): a header the app sets wins. One directive each:
	# in one block, Caddy sets them only when the response has none of them.
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header -Server
	log {
		output stdout
		format json
	}
}

(app) {
	import common
	reverse_proxy 127.0.0.1:{args[0]} {
		# The app routes by Host, and trusts only loopback: it reads the one
		# client address Caddy resolved, replacing any chain.
		header_up Host {host}
		header_up X-Forwarded-For {client_ip}
	}
}
{{range .Blocks}}
# {{.App}} {{.Stack}}
{{join .Hosts ", "}} {
{{- if .Cert}}
	# Behind Cloudflare: its origin certificate for {{.Domain}}.
	tls {{$.CertDir}}/{{.Domain}}.pem {{$.CertDir}}/{{.Domain}}.key
{{- end}}
	import app {{.Port}}
}
{{end -}}
